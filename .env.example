# Copiar como .env.local y completar. Nunca subir .env.local al repositorio.

# URL pública del sitio (sitemap, metadatos, enlaces)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon/publishable): solo puede leer lo que RLS permite.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (service role): SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (protección contra bots en formularios).
# Desarrollo: claves de prueba públicas de Cloudflare (siempre aprueban):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Producción: crear un widget en dash.cloudflare.com → Turnstile y usar sus claves.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cadena de conexion a Postgres (Session pooler). SOLO servidor/CLI.
SUPABASE_DB_URL=
